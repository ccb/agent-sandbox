[gd_scene load_steps=11 format=3]

[ext_resource type="Script" path="res://scripts/penn_replay.gd" id="1_replay"]
[ext_resource type="Script" path="res://scripts/tiled_map.gd" id="2_tiled"]
[ext_resource type="Texture2D" uid="uid://cq7ritci4gvgn" path="res://Cute_Fantasy_Free/Player/Player.png" id="3_player"]
[ext_resource type="Script" path="res://scripts/camera_controls.gd" id="4_cam"]
[ext_resource type="Script" path="res://scripts/agent_panel.gd" id="5_panel"]
[ext_resource type="Theme" path="res://theme/cute_fantasy_ui.tres" id="6_theme"]
[ext_resource type="Script" path="res://scripts/building_labels.gd" id="7_buildings"]
[ext_resource type="Script" path="res://scripts/minimap.gd" id="8_minimap"]
[ext_resource type="Script" path="res://scripts/heatmap_panel.gd" id="9_heatmap"]
[ext_resource type="Script" path="res://scripts/live_hud.gd" id="10_hud"]

[node name="PennReplay" type="Node2D"]
script = ExtResource("1_replay")
player_sheet = ExtResource("3_player")

; The campus, drawn with the Kenney CC0 urban tiles (same map the sim walked).
[node name="Map" type="TileMapLayer" parent="."]
script = ExtResource("2_tiled")
map_path = "res://maps/upenn_core_urban.tmj"

; Floating building name-plates over the campus, shown zoomed-out and faded as you
; zoom in (building_labels.gd). Sits above the Map but before the agent sprites
; penn_replay.gd adds at runtime, so agent name-plates always draw on top.
[node name="BuildingLabels" type="Node2D" parent="."]
script = ExtResource("7_buildings")

; The map is the 34th–36th x Spruce–Walnut block (3920x4464 px at 1 m/tile),
; cropped to the four street edges — a PORTRAIT map in a 1920x1080 landscape
; window. zoom 0.249 contain-fits: the FULL block is visible (the height fills the
; window: 4464 * 0.242 ~= 1080 px), at the cost of grey margins on the left/right
; (a portrait map can't fill a landscape window without cropping). Centred on the
; block centre so it's symmetric.
[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(1960, 2232)
zoom = Vector2(0.242, 0.242)
script = ExtResource("4_cam")

; Screen-space overlay (fixed on screen, unaffected by camera pan/zoom). The
; character sidebar sits in the left grey margin a portrait map leaves in a
; landscape window, so it covers no campus. penn_replay.gd fills it after load.
[node name="UI" type="CanvasLayer" parent="."]
; Above the runtime "perception fog" overlay (penn_replay.gd adds it on its own
; CanvasLayer at layer 1), so the sidebar + minimap are never dimmed by the fog.
layer = 10

[node name="AgentPanel" type="PanelContainer" parent="UI"]
anchor_bottom = 1.0
offset_right = 300.0
grow_vertical = 2
theme = ExtResource("6_theme")
script = ExtResource("5_panel")

; Bottom-right minimap overview (minimap.gd). penn_replay.gd sizes + anchors it and
; feeds it the camera + agents after load; sits over the campus in the bottom-right.
[node name="Minimap" type="Control" parent="UI"]
script = ExtResource("8_minimap")

; Top-right run monitor (live_hud.gd, issue #264): cost meter + backend health +
; Emergency Stop. Pure UI like the sidebar and minimap — penn_replay.gd wires it to a
; data source: simulated usage in baked-replay mode (the default), or the real
; backend's GET /usage + /health when live_backend_url / SIM_API_URL is set. It
; anchors itself to the top-right corner in its own _ready.
[node name="LiveHud" type="PanelContainer" parent="UI"]
theme = ExtResource("6_theme")
script = ExtResource("10_hud")

; Movement-heatmap pop-up (heatmap_panel.gd), on its OWN CanvasLayer above the UI layer
; (10) so, when shown, its full-screen dim reliably covers the sidebar + minimap + world
; and it reads as a modal window (the same own-CanvasLayer trick the fog uses for
; predictable layering). Hidden until opened (H key / the sidebar "Heatmap" button);
; penn_replay.gd feeds it the replay after load and pushes the current step so the heat
; accumulates live.
[node name="HeatmapLayer" type="CanvasLayer" parent="."]
layer = 11

[node name="HeatmapPanel" type="Control" parent="HeatmapLayer"]
visible = false
script = ExtResource("9_heatmap")
