; The map is the 34th–36th x Spruce–Walnut core only (5632x7040 px at 1 m/tile),
; so the whole frame IS the middle of campus. Centred on the map; zoom 0.176 fits
; the full (tall) area to the 1000x1250 portrait window (see project.godot). If you
; resize the window, nudge this zoom to match (≈ window_height / 7040).
[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(2810, 3510)
zoom = Vector2(0.176, 0.176)
