; The campus, drawn with the Kenney CC0 urban tiles (same map the sim walked).
[node name="Map" type="TileMapLayer" parent="."]
script = ExtResource("2_tiled")
map_path = "res://maps/upenn_core_urban.tmj"

; The map is now 11200x7888 px (1 m/tile). Rather than frame the whole core, we
; zoom into the MIDDLE — Van Pelt, Williams, Meyerson, College Hall, the Locust
; Walk spine, where the three agents actually walk — so the trees read as trees
; and the bounding streets fall off-frame. position is centred on the agents'
; activity; raise zoom to push further in, lower it (toward ~0.35) to take in more
; of the core (the agents range wider than one tight frame can hold at once).
[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(3000, 1430)
zoom = Vector2(0.8, 0.8)
