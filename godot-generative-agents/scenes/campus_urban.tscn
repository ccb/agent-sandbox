[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/tiled_map.gd" id="1_tiled"]

[node name="CampusUrban" type="Node2D"]

; NOTE: do not scale this TileMapLayer — scaling a tilemap leaves sub-pixel gaps
; between cells (the old white seams). Size the view with the camera zoom instead.
[node name="Map" type="TileMapLayer" parent="."]
script = ExtResource("1_tiled")
map_path = "res://maps/upenn_core_urban.tmj"

; The map is now 11200x7888 px (1 m/tile) — a campus overview at a finer grid.
; position = the built-up centroid; zoom 0.25 keeps the core in frame. Size the
; view with the camera zoom, never by scaling the TileMapLayer (that leaves
; sub-pixel white seams between cells). Raise the zoom to push into the middle.
[node name="Camera2D" type="Camera2D" parent="."]
position = Vector2(5400, 3450)
zoom = Vector2(0.25, 0.25)
