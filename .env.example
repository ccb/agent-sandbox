# Copy me to `.env` (git-ignored) at the repo root and fill in what you need.
# The Penn backend loads this file at startup. Already-exported environment
# variables always win. Never commit `.env` or paste a real key into source,
# logs, issues, or run artifacts.

# The live Penn server's real brain (serve_penn --brain llm) reads ONLY this key:
ANTHROPIC_API_KEY=

# Bearer token for the HTTP API; required when binding a non-loopback host.
# SIM_API_TOKEN=
