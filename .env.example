# Copy me to `.env` (git-ignored) at the repo root and fill in what you need.
# Every backend CLI loads this file at startup (backend/env.py):
#   - godot-generative-agents/sim/serve_penn.py   (the live Penn server)
#   - python -m backend.run_simulation             (the Smallville batch runner)
#   - python -m backend.api                        (the demo API world)
# Already-exported environment variables ALWAYS win over these values.

# The live Penn server's real brain (serve_penn --brain llm) reads ONLY this key:
ANTHROPIC_API_KEY=

# Smallville batch-runner LLM knobs (backend.run_simulation; see backend/README.md).
# The Penn live server ignores these on purpose -- its model comes from the
# world YAML's llm: block.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# LLM_MAX_COST=5.00

# Bearer token for the HTTP API; required when binding a non-loopback host.
# SIM_API_TOKEN=
