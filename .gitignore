# JSON/JSONL here are mostly generated data (OSM dumps, replay traces, fine-tuning
# sets, the vendored Smallville storage). A blanket `*.json` used to ignore them all,
# but it also swallowed real source (the furniture catalog, the web app's package.json)
# and forced `-f` adds, so it's dropped. JSONL (always data here) stays ignored;
# generated *.json are ignored by path below.
*.jsonl
*.json.*
*.jsonl.*
# ...except #623's committed golden-test fixture: hand-authored test data, not
# generated output, for the most-wanted-actions report's aggregator.
!godot-generative-agents/tests/fixtures/wishes_sample.jsonl
# ...and #699's committed golden-test fixture for most-common-actions aggregator.
!godot-generative-agents/tests/fixtures/events_sample.jsonl
# ...and the RunStore's committed runs: frames/events are the replay payload, so a
# tracked run is useless without them (the Past-runs browser reads frames.jsonl).
!godot-generative-agents/runs/**/*.jsonl

# Generated per-checkout / per-run — regenerable, never commit.
godot-generative-agents/godot/maps/penn_replay.json
godot-generative-agents/tools/geo/out/upenn_core_ville_addresses.json
godot-generative-agents/tools/geo/out/upenn_furniture_debug.tmj

# Godot's per-checkout import cache — regenerated by run.sh's --import on first
# launch; never commit (a bulk add once swept it in, untracked again since).
godot-generative-agents/**/.godot/

# Old-layout local remnants (the real files live under godot-generative-agents/godot/);
# these linger in working trees and got swept in by the same bulk add.
godot-generative-agents/maps/penn_replay.json
godot-generative-agents/scripts/building_labels.gd.uid

# Project-shared Claude Code config (commit it); per-dev settings.local.json stays ignored.
**/.claude/settings.local.json
!.claude/settings.json
# Claude Code local git worktrees (per-dev; never commit)
.claude/worktrees/
.worktrees/
# Same for Codex, which keeps its own worktrees under .codex/
.codex/

# macOS
.DS_Store

# Local scratch — not part of the engine (never commit)
engine-overview.html

# superpowers skill artifacts (brainstorming specs / implementation plans) — kept local
docs/superpowers/

# uv project files ARE tracked: uv.lock pins exact versions for reproducible
# `uv sync`, and .python-version pins the interpreter (3.12, within the CI range).
# Only the resolved virtualenv (.venv, below) stays local.

# External upstream clones are local reference material, never project source.
/external/
/generative-agents/

# --- godot-generative-agents web viewer ---
# Build/install artifacts — all regenerated locally (npm run export:godot /
# npm install / npm run build / npm run gen:docs), never committed.
godot-generative-agents/web/public/godot/
godot-generative-agents/web/public/docs/
godot-generative-agents/web/node_modules/
godot-generative-agents/web/dist/
godot-generative-agents/web/*.tsbuildinfo
# Vercel CLI local state — `vercel link` writes the org/project ids and pulled env
# here, per dev. The deploy config that IS shared lives in web/vercel.json (#882).
godot-generative-agents/web/.vercel/
# (The app's package.json / tsconfig*.json / committed replay are tracked normally
# now that the blanket *.json ignore is gone; the build dirs above stay excluded.)
app/dist/
ios/build/
ios/*.xcodeproj
