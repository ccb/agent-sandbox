# uv project files ARE tracked: uv.lock pins exact versions for reproducible
# `uv sync`, and .python-version pins the interpreter (3.12, within the CI range).
# Only the resolved virtualenv (.venv, below) stays local.

# External benchmark clones (e.g. ScienceWorld) live under benchmarks/ for local
# reference and experiments. They are upstream repos with their own history and a
# bundled multi-MB JAR — never commit them into our tree. See
# docs/design/scienceworld-interface.md (#47) for how to obtain and use them.
/benchmarks/

# External upstream repo clones (e.g. generative_agents) — kept local for
# reference/experiments; never commit them into our tree.
/external/

parsely_pdfs/*.pdf

# --- godot-generative-agents web viewer ---
# Build/install artifacts — all regenerated locally (npm run export:godot /
# npm install / npm run build), never committed.
godot-generative-agents/web/public/godot/
godot-generative-agents/web/node_modules/
godot-generative-agents/web/dist/
godot-generative-agents/web/*.tsbuildinfo
# Re-include the app's JSON (package.json, tsconfig*.json and the committed replay)
# — all otherwise swallowed by the blanket `*.json` above. The excluded dirs above
# stay excluded (git can't re-include inside an ignored parent), so build output and
# deps are still skipped. (pnpm-lock.yaml / pnpm-workspace.yaml are YAML, tracked.)
!godot-generative-agents/web/**/*.json
