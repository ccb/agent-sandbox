  "goals": [
    {
      "name": "active-by-tier + long->medium->short render, secret filtered",
      "goals": [
        {
          "description": "Complete the summoning rite in the crypt",
          "tier": "long",
          "done": false,
          "secret": true
        },
        {
          "description": "Gather the ritual materials",
          "tier": "medium",
          "done": true,
          "secret": false
        },
        {
          "description": "Bring the sacrifice to the crypt",
          "tier": "medium",
          "done": false,
          "secret": false
        },
        {
          "description": "Avoid the Nighthawks",
          "tier": "short",
          "done": false,
          "secret": false
        }
      ],
      "expected_active_by_tier": {
        "long": [
          "Complete the summoning rite in the crypt"
        ],
        "medium": [
          "Bring the sacrifice to the crypt"
        ],
        "short": [
          "Avoid the Nighthawks"
        ]
      },
      "expected_prompt_order_revealed_true": [
        "Complete the summoning rite in the crypt",
        "Bring the sacrifice to the crypt",
        "Avoid the Nighthawks"
      ],
      "expected_prompt_order_revealed_false": [
        "Bring the sacrifice to the crypt",
        "Avoid the Nighthawks"
      ]
    }
