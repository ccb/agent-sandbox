{
  "_about": "Language-neutral fixtures for SPEC.md. Both the Python (Tingen) and TS (Yumina) cognition implementations MUST pass these. Float assertions use tolerance 1e-6. Retrieval/goal/veto outputs are exact.",
  "constants": {
    "ALPHA_RECENCY": 1.0,
    "ALPHA_IMPORTANCE": 1.0,
    "ALPHA_RELEVANCE": 1.0,
    "DEFAULT_DECAY": 0.95,
    "DEFAULT_MAX_RECORDS": 6,
    "DEFAULT_TOKEN_BUDGET": 800,
    "REFLECTION_THRESHOLD": 30.0,
    "REFLECTION_DEFAULT_IMPORTANCE": 5.0,
    "OBSERVATION_DEFAULT_IMPORTANCE": 1.0
  },
  "stop_words": [
    "a",
    "an",
    "and",
    "are",
    "as",
    "at",
    "be",
    "by",
    "for",
    "from",
    "had",
    "has",
    "have",
    "he",
    "her",
    "here",
    "his",
    "i",
    "in",
    "is",
    "it",
    "its",
    "me",
    "my",
    "of",
    "on",
    "or",
    "she",
    "that",
    "the",
    "their",
    "them",
    "they",
    "this",
    "to",
    "was",
    "were",
    "with",
    "you",
    "your"
  ],
  "tokenizer": "lowercase; split on /[^a-z0-9]+/; drop empties and stop_words. relevance(query,text) = |tokens(query) ∩ tokens(text)| / |tokens(query)|, or 0.0 if tokens(query) is empty.",
  "scoring": {
    "recency": [
      {
        "name": "fresh (same turn)",
        "last_accessed_turn": 10,
        "turn": 10,
        "decay": 0.95,
        "expected": 1.0
      },
      {
        "name": "one turn old",
        "last_accessed_turn": 9,
        "turn": 10,
        "decay": 0.95,
        "expected": 0.95
      },
      {
        "name": "six turns old",
        "last_accessed_turn": 4,
        "turn": 10,
        "decay": 0.95,
        "expected": 0.7350918906
      },
      {
        "name": "future clamps to 0 delta",
        "last_accessed_turn": 12,
        "turn": 10,
        "decay": 0.95,
        "expected": 1.0
      }
    ],
    "importance": [
      {
        "name": "mid",
        "importance": 7.0,
        "expected": 0.7
      },
      {
        "name": "clamp high",
        "importance": 12.0,
        "expected": 1.0
      },
      {
        "name": "clamp low",
        "importance": -1.0,
        "expected": 0.0
      }
    ],
    "relevance": [
      {
        "name": "full overlap",
        "query": "player food bridge",
        "text": "The player offered me food at the bridge",
        "expected": 1.0
      },
      {
        "name": "partial overlap",
        "query": "player food bridge",
        "text": "The troll guards the bridge",
        "expected": 0.3333333333
      },
      {
        "name": "no content overlap",
        "query": "player food bridge",
        "text": "I lit the lamp",
        "expected": 0.0
      },
      {
        "name": "query is all stop-words",
        "query": "the and is it",
        "text": "anything here",
        "expected": 0.0
      }
    ]
  },
