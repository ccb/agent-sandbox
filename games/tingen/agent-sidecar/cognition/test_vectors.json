  "veto": [
    {
      "name": "no_rite_without_site: a task-bearer off-site is amended to idle",
      "action": {
        "verb": "perform_ritual_step",
        "public": false,
        "reveals_membership": false
      },
      "actor": {
        "task": { "ritual": "summoning_descent" }
      },
      "world_state": {
        "player_triggered": false,
        "actor_at_rite_site": false
      },
      "expected": {
        "decision": "amend",
        "invariant": "no_rite_without_site",
        "amended_action": {
          "verb": "idle"
        }
      }
    },
    {
      "name": "no_rite_without_site: a task-bearer on-site performs the rite",
