Shop="*res://src/Shop.gd"
AudioManager="*res://src/AudioManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/ui/tingen_theme.tres"

