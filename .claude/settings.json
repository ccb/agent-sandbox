{
  "permissions": {
    "allow": [
      "Bash(uv run black *)",
      "Bash(uv run pytest *)",
      "Bash(uv run jupyter nbconvert *)",
      "Bash(uv sync *)",
      "Bash(git diff --stat *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/run_renderer_coverage.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/update_progress.sh\""
          }
        ]
      }
    ]
  }
}
